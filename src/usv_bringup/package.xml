<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>usv_bringup</name>
  <version>0.1.0</version>
  <description>Launch orchestration and bringup configuration for multi-USV fault-aware swarm</description>
  <maintainer email="pritish@todo.todo">Pritish Bhatasana</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>usv_msgs</exec_depend>
  <exec_depend>usv_sim_core</exec_depend>
  <exec_depend>usv_perception_mesh</exec_depend>
  <exec_depend>usv_health_diagnosis</exec_depend>
  <exec_depend>usv_recovery_planner</exec_depend>
  <exec_depend>usv_policy_marl</exec_depend>
  <exec_depend>usv_safety_shield</exec_depend>
  <exec_depend>usv_fault_injector</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
